#!/bin/sh
# The instance's own commit-msg hooks. Enable per clone: git config core.hooksPath .githooks
#
# Extension point (systems/distribution.md): every executable file in
# .githooks.d/commit-msg/ runs in name order with the message file as its argument;
# the first that fails rejects the commit. The framework adds no check of its own
# here; it ships the hook so an instance never has to own a file in .githooks/.
root="$(git rev-parse --show-toplevel)"
for hook in "$root/.githooks.d/commit-msg"/*; do
  [ -f "$hook" ] && [ -x "$hook" ] || continue
  "$hook" "$@" || exit $?
done
