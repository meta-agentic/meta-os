# OS noise
.DS_Store
*.swp

# Obsidian workspace/local state (keep config + plugin list, drop per-machine state)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Local-only captures — memory/raw is scratch; promote to wiki before committing.
# Uncomment the next line if raw captures should stay off the remote.
# memory/raw/**

# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem

# claude-flow runtime state — operational, not knowledge
.claude-flow/
.swarm/
agentdb.rvf*

# Claude Code project surface — INSTANCE-owned in the one-repository layout
# (systems/distribution.md; the old wholesale ignore was narrowed on purpose). The
# framework tracks nothing under .claude/ and its gate refuses to. An instance commits
# its contract (.claude/CLAUDE.md, instantiated by scripts/bootstrap.sh) and its
# settings.json; the discovery links scripts/packs.sh sync generates under
# .claude/{skills,agents,hooks}/ and every machine-local file stay out.
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json

# Instance operational data — machine-local, never canon (the instance template's rules)
automations/runs.jsonl
instance.config.json

# The pack links scripts/packs.sh sync places in skills/ beside the framework's own skill
# folders are generated too; sync lists them in $GIT_DIR/info/exclude per clone, since a
# .gitignore rule cannot tell a generated link from a framework folder of the same shape.

# Agent memory store (local, per-machine). Binary SQLite plus its WAL
# sidecars cannot be shared between clones, and concurrent sessions conflict
# on every write.
ruvector.db
**/ruvector.db
*.db-wal
*.db-shm

# Python caches — the gates in scripts/ import each other and the suites in
# tests/ and pipeline/tests/ run them, so both grow bytecode that is build
# output, not content.
__pycache__/
*.pyc

